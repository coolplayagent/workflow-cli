load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
exports_files(["Cargo.toml"])
rust_library(
    name = "workflow_workspace_local",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = ["//crates/workflow-workspaces:workflow_workspaces", "//crates/workflow-artifacts:workflow_artifacts"] + all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
)
rust_test(
    name = "tests",
    size = "small",
    crate = ":workflow_workspace_local",
    deps = ["//crates/workflow-artifact-local:workflow_artifact_local"] + all_crate_deps(normal_dev = True),
)
