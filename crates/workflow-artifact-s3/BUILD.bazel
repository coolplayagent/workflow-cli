load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
exports_files(["Cargo.toml"])
rust_library(
    name = "workflow_artifact_s3",
    srcs = glob(["src/**/*.rs"]),
    compile_data = ["src/schema.sql"],
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = ["//crates/workflow-artifacts:workflow_artifacts"] + all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
)
rust_test(
    name = "tests",
    size = "small",
    crate = ":workflow_artifact_s3",
    deps = ["//crates/workflow-ir:workflow_ir", "//crates/workflow-artifact-local:workflow_artifact_local"] + all_crate_deps(normal_dev = True),
)
