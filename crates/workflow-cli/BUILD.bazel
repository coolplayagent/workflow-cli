load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test", "rust_binary")

exports_files(["Cargo.toml"])

rust_library(
    name = "workflow_cli",
    srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = ["//crates/workflow-templates:workflow_templates", "//crates/workflow-credentials:workflow_credentials", "//crates/workflow-service:workflow_service", "//crates/workflow-runstore-postgres:workflow_runstore_postgres", "//crates/workflow-daemon-local:workflow_daemon_local", "//crates/workflow-backup-local:workflow_backup_local", "//crates/workflow-effect-http:workflow_effect_http", "//crates/workflow-effects:workflow_effects", "//crates/workflow-models:workflow_models", "//crates/workflow-model-http:workflow_model_http", "//crates/workflow-workspaces:workflow_workspaces", "//crates/workflow-workspace-local:workflow_workspace_local", "//crates/workflow-gates:workflow_gates", "//crates/workflow-artifacts:workflow_artifacts", "//crates/workflow-artifact-local:workflow_artifact_local", "//crates/workflow-artifact-s3:workflow_artifact_s3", "//crates/workflow-runtime:workflow_runtime", "//crates/workflow-runstore:workflow_runstore", "//crates/workflow-runstore-sqlite:workflow_runstore_sqlite", "//crates/workflow-ir:workflow_ir", "//crates/workflow-validator:workflow_validator", "//crates/workflow-worker:workflow_worker", "//crates/workflow-builtin-capabilities:workflow_builtin_capabilities", "//crates/workflow-kernel:workflow_kernel"] + ["//crates/workflow-definitions:workflow_definitions", "//crates/workflow-registry-sqlite:workflow_registry_sqlite"] + all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
)

rust_test(
    name = "tests",
    size = "small",
    crate = ":workflow_cli",
    data = ["//:fixtures"],
    deps = all_crate_deps(normal_dev = True),
)

rust_binary(
    name = "workflow",
    srcs = ["src/main.rs"],
    edition = "2024",
    deps = [":workflow_cli"],
    visibility = ["//visibility:public"],
)
