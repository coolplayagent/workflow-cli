{
  "ok": true,
  "result": {
    "$defs": {
      "CallKind": {
        "enum": [
          "write",
          "query"
        ],
        "type": "string"
      },
      "CapabilityDescriptor": {
        "additionalProperties": false,
        "properties": {
          "capability": {
            "$ref": "#/$defs/VersionRef"
          },
          "effects": {
            "$ref": "#/$defs/EffectContract"
          },
          "error_codes": {
            "additionalProperties": {
              "$ref": "#/$defs/FailureClass"
            },
            "type": "object"
          },
          "inputs": {
            "additionalProperties": {
              "$ref": "#/$defs/Field"
            },
            "type": "object"
          },
          "outputs": {
            "additionalProperties": {
              "$ref": "#/$defs/Field"
            },
            "type": "object"
          },
          "schema_version": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "skill": {
            "anyOf": [
              {
                "$ref": "#/$defs/VersionRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "timeout_ms": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "usage": {
            "type": "string"
          }
        },
        "required": [
          "schema_version",
          "capability",
          "inputs",
          "outputs",
          "timeout_ms",
          "error_codes",
          "effects",
          "usage"
        ],
        "type": "object"
      },
      "EffectContract": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "read_only",
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "compensation": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/VersionRef"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "idempotency": {
                "$ref": "#/$defs/Idempotency"
              },
              "query": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/VersionRef"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": {
                "const": "write",
                "type": "string"
              }
            },
            "required": [
              "type",
              "idempotency"
            ],
            "type": "object"
          }
        ]
      },
      "EffectIntent": {
        "additionalProperties": false,
        "properties": {
          "capability": {
            "$ref": "#/$defs/CapabilityDescriptor"
          },
          "command_digest": {
            "type": "string"
          },
          "command_id": {
            "type": "string"
          },
          "created_at_unix_ms": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "input_digest": {
            "type": "string"
          },
          "inputs": {
            "additionalProperties": true,
            "type": "object"
          },
          "instance_id": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "node_id": {
            "type": "string"
          },
          "operation_key": {
            "type": "string"
          },
          "policy": {
            "$ref": "#/$defs/EffectPolicy"
          },
          "run_digest": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          },
          "schema_version": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "workflow": {
            "$ref": "#/$defs/VersionRef"
          }
        },
        "required": [
          "schema_version",
          "operation_key",
          "run_id",
          "run_digest",
          "instance_id",
          "workflow",
          "node_id",
          "command_id",
          "command_digest",
          "capability",
          "inputs",
          "input_digest",
          "policy",
          "created_at_unix_ms"
        ],
        "type": "object"
      },
      "EffectPolicy": {
        "additionalProperties": false,
        "properties": {
          "call_identity": {
            "$ref": "#/$defs/VersionRef",
            "description": "Service principal binding, not an authenticated human actor assertion."
          },
          "identity": {
            "$ref": "#/$defs/VersionRef"
          },
          "retry": {
            "$ref": "#/$defs/RetryPolicy"
          },
          "target": {
            "$ref": "#/$defs/VersionRef",
            "description": "Logical provider/resource boundary, resolved by the host without secrets."
          }
        },
        "required": [
          "identity",
          "target",
          "call_identity",
          "retry"
        ],
        "type": "object"
      },
      "FailureClass": {
        "enum": [
          "invalid_input",
          "permanent",
          "permission_denied",
          "business_rejected",
          "transient",
          "cancelled",
          "unknown_effect"
        ],
        "type": "string"
      },
      "Field": {
        "additionalProperties": false,
        "properties": {
          "required": {
            "type": "boolean"
          },
          "value_type": {
            "$ref": "#/$defs/ValueType"
          }
        },
        "required": [
          "value_type",
          "required"
        ],
        "type": "object"
      },
      "Idempotency": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "mode": {
                "const": "none",
                "type": "string"
              }
            },
            "required": [
              "mode"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "mode": {
                "const": "key",
                "type": "string"
              },
              "retention_ms": {
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "scope": {
                "type": "string"
              }
            },
            "required": [
              "mode",
              "scope",
              "retention_ms"
            ],
            "type": "object"
          }
        ]
      },
      "RetryPolicy": {
        "additionalProperties": false,
        "properties": {
          "initial_backoff_ms": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "max_backoff_ms": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "max_calls": {
            "description": "Includes queries and writes; persists across leases and process restarts.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "total_write_ms": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "max_calls",
          "initial_backoff_ms",
          "max_backoff_ms",
          "total_write_ms"
        ],
        "type": "object"
      },
      "ValueType": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "string",
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "boolean",
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "integer",
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "number",
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "items": {
                "$ref": "#/$defs/ValueType"
              },
              "type": {
                "const": "array",
                "type": "string"
              }
            },
            "required": [
              "type",
              "items"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "fields": {
                "additionalProperties": {
                  "$ref": "#/$defs/ValueType"
                },
                "type": "object"
              },
              "type": {
                "const": "object",
                "type": "string"
              }
            },
            "required": [
              "type",
              "fields"
            ],
            "type": "object"
          }
        ]
      },
      "VersionRef": {
        "additionalProperties": false,
        "description": "Versions are immutable opaque release identifiers, never ranges or `latest`.",
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "version"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "attempt_id": {
        "type": "string"
      },
      "deadline_unix_ms": {
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      },
      "epoch": {
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      },
      "intent": {
        "$ref": "#/$defs/EffectIntent"
      },
      "issued_at_unix_ms": {
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      },
      "kind": {
        "$ref": "#/$defs/CallKind"
      },
      "number": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "prepared_revision": {
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      }
    },
    "required": [
      "intent",
      "attempt_id",
      "epoch",
      "number",
      "kind",
      "prepared_revision",
      "issued_at_unix_ms",
      "deadline_unix_ms"
    ],
    "title": "EffectAttempt",
    "type": "object"
  }
}
