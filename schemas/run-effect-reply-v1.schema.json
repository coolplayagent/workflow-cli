{
  "ok": true,
  "result": {
    "$defs": {
      "EffectReceipt": {
        "additionalProperties": false,
        "properties": {
          "intent_digest": {
            "type": "string"
          },
          "operation_key": {
            "type": "string"
          },
          "outputs": {
            "additionalProperties": true,
            "type": "object"
          },
          "provider_receipt": {
            "type": "string"
          },
          "resource_id": {
            "type": "string"
          },
          "target": {
            "$ref": "#/$defs/VersionRef"
          }
        },
        "required": [
          "operation_key",
          "intent_digest",
          "target",
          "resource_id",
          "provider_receipt",
          "outputs"
        ],
        "type": "object"
      },
      "FailureClass": {
        "enum": [
          "invalid_input",
          "permanent",
          "permission_denied",
          "business_rejected",
          "transient",
          "cancelled",
          "unknown_effect"
        ],
        "type": "string"
      },
      "Observation": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "receipt": {
                "$ref": "#/$defs/EffectReceipt"
              },
              "status": {
                "const": "applied",
                "type": "string"
              }
            },
            "required": [
              "status",
              "receipt"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "Provider guarantees this invocation did not apply an effect. Timeouts,\ntransport errors and ambiguous HTTP 5xx must use Unknown instead.",
            "properties": {
              "class": {
                "$ref": "#/$defs/FailureClass"
              },
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "status": {
                "const": "not_applied",
                "type": "string"
              }
            },
            "required": [
              "status",
              "code",
              "class",
              "message"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "A query found nothing *at that instant*. It does not fence an old writer.",
            "properties": {
              "status": {
                "const": "absent",
                "type": "string"
              }
            },
            "required": [
              "status"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "reason": {
                "type": "string"
              },
              "status": {
                "const": "unknown",
                "type": "string"
              }
            },
            "required": [
              "status",
              "reason"
            ],
            "type": "object"
          }
        ]
      },
      "VersionRef": {
        "additionalProperties": false,
        "description": "Versions are immutable opaque release identifiers, never ranges or `latest`.",
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "version"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "observation": {
        "$ref": "#/$defs/Observation"
      },
      "request_digest": {
        "type": "string"
      }
    },
    "required": [
      "request_digest",
      "observation"
    ],
    "title": "EffectReply",
    "type": "object"
  }
}
