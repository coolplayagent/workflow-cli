  "properties": {
    "capabilities": {
      "items": {
        "$ref": "#/$defs/CapabilityDescriptor"
      },
      "type": "array"
    },
    "model_policies": {
      "items": {
        "$ref": "#/$defs/PolicySpec"
      },
      "type": "array"
    },
    "postconditions": {
      "items": {
        "$ref": "#/$defs/Postcondition"
      },
      "type": "array"
    },
    "root": {
      "$ref": "#/$defs/VersionRef"
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
