        },
        "policy": {
          "$ref": "#/$defs/VersionRef"
        },
        "schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "task": {
          "$ref": "#/$defs/CapabilityDescriptor"
        },
        "tools": {
          "items": {
            "$ref": "#/$defs/CapabilityDescriptor"
          },
          "type": "array"
