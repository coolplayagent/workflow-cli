          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "format": {
              "const": "utf8",
              "type": "string"
            }
          },
          "required": [
            "format"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "format": {
              "const": "json",
              "type": "string"
