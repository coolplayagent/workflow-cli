            }
          },
          "required": [
            "source",
            "field"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "field": {
              "type": "string"
            },
            "node": {
              "type": "string"
            },
            "source": {
              "const": "node_output",
              "type": "string"
            }
          },
          "required": [
            "source",
            "node",
            "field"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "source": {
              "const": "literal",
              "type": "string"
            },
            "value": true
          },
          "required": [
            "source",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "context_bytes": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
