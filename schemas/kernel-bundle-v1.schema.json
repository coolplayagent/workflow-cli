        "policy": {
          "$ref": "#/$defs/Policy"
        },
        "repository": {
          "$ref": "#/$defs/Binding"
        },
        "revision": {
          "$ref": "#/$defs/Binding"
        },
        "workflow": {
          "$ref": "#/$defs/VersionRef"
