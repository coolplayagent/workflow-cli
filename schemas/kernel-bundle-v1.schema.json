        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "fork",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "$ref": "#/$defs/JoinMode"
