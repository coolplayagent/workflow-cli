        },
        "inputs": {
          "additionalProperties": {
            "$ref": "#/$defs/Field"
          },
          "type": "object"
        },
        "outputs": {
          "additionalProperties": {
            "$ref": "#/$defs/Field"
          },
          "type": "object"
