          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "compensation": {
              "anyOf": [
                {
                  "$ref": "#/$defs/VersionRef"
                },
                {
                  "type": "null"
                }
              ]
