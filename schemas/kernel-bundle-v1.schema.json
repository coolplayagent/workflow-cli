            "type": {
              "const": "join",
              "type": "string"
            }
          },
          "required": [
            "type",
            "mode",
            "remaining"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "event": {
              "type": "string"
            },
            "timeout_ms": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "wait",
              "type": "string"
            }
          },
          "required": [
            "type",
            "event",
            "timeout_ms"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "subworkflow",
              "type": "string"
            },
            "workflow": {
              "$ref": "#/$defs/VersionRef"
            }
          },
          "required": [
            "type",
            "workflow"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "body": {
              "$ref": "#/$defs/VersionRef"
            },
            "deadline_ms": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "max_iterations": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "loop",
              "type": "string"
            }
          },
          "required": [
            "type",
            "body",
            "max_iterations",
            "deadline_ms"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "outcome": {
              "$ref": "#/$defs/TerminalOutcome"
            },
            "type": {
              "const": "terminal",
              "type": "string"
            }
          },
          "required": [
            "type",
            "outcome"
          ],
          "type": "object"
        }
      ]
