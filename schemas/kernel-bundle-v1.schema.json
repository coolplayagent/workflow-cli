          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "skill": {
          "anyOf": [
            {
              "$ref": "#/$defs/VersionRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "timeout_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "usage": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "capability",
        "inputs",
        "outputs",
        "timeout_ms",
        "error_codes",
        "effects",
        "usage"
      ],
      "type": "object"
    },
    "Condition": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "field": {
              "type": "string"
            },
            "op": {
              "const": "exists",
              "type": "string"
            }
          },
          "required": [
            "op",
            "field"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "field": {
              "type": "string"
            },
            "op": {
              "const": "eq",
              "type": "string"
            },
            "value": true
          },
          "required": [
            "op",
            "field",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "field": {
              "type": "string"
            },
            "op": {
              "const": "not_eq",
              "type": "string"
            },
            "value": true
          },
          "required": [
            "op",
            "field",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "conditions": {
              "items": {
                "$ref": "#/$defs/Condition"
              },
              "type": "array"
            },
            "op": {
              "const": "all",
              "type": "string"
            }
          },
          "required": [
            "op",
            "conditions"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "conditions": {
              "items": {
                "$ref": "#/$defs/Condition"
              },
              "type": "array"
            },
            "op": {
              "const": "any",
              "type": "string"
            }
          },
          "required": [
            "op",
            "conditions"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "condition": {
              "$ref": "#/$defs/Condition"
            },
            "op": {
              "const": "not",
              "type": "string"
            }
          },
          "required": [
            "op",
            "condition"
          ],
          "type": "object"
        }
      ]
    },
    "ContentSchema": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "format": {
              "const": "bytes",
              "type": "string"
            }
          },
          "required": [
            "format"
