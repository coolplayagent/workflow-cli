            "type": {
              "const": "object",
              "type": "string"
            }
          },
          "required": [
            "type",
            "fields"
          ],
          "type": "object"
        }
      ]
    },
    "VersionRef": {
      "additionalProperties": false,
      "description": "Versions are immutable opaque release identifiers, never ranges or `latest`.",
