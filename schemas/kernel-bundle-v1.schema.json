        "max_age_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "node_id": {
          "type": "string"
        },
        "pass_field": {
          "description": "Required Boolean in the accepted worker output; artifact text is not a verdict.",
          "type": "string"
        },
        "report_type": {
          "$ref": "#/$defs/ArtifactType"
