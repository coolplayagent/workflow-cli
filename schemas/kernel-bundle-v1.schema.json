      "required": [
        "schema_version",
        "policy",
        "task",
        "goal",
        "tools",
        "budget"
      ],
      "type": "object"
    },
    "Postcondition": {
      "additionalProperties": false,
      "description": "Mandatory success postcondition, frozen with its graph and policy in the run bundle.",
      "properties": {
        "action": {
          "$ref": "#/$defs/VersionRef"
        },
        "artifacts": {
          "$ref": "#/$defs/Binding"
        },
        "input_node": {
          "description": "The current frame's task whose resolved inputs identify the checked subject.",
          "type": "string"
