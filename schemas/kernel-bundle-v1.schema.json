        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "type": "object"
    },
    "Workflow": {
      "additionalProperties": false,
      "properties": {
        "edges": {
