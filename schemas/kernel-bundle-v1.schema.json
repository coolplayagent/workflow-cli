        "id": {
          "type": "string"
        },
        "route": {
          "$ref": "#/$defs/Route"
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "from",
        "to",
        "route"
      ],
      "type": "object"
    },
    "EffectContract": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "read_only",
              "type": "string"
