        "model_calls": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "output_tokens_per_call": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "response_bytes": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "tool_calls": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "model_calls",
        "tool_calls",
        "context_bytes",
        "response_bytes",
        "output_tokens_per_call"
      ],
      "type": "object"
    },
    "CapabilityDescriptor": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "$ref": "#/$defs/VersionRef"
        },
        "effects": {
          "$ref": "#/$defs/EffectContract"
        },
        "error_codes": {
          "additionalProperties": {
