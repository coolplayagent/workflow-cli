{
  "$defs": {
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "context_bytes": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "model_calls": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "output_tokens_per_call": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "response_bytes": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "tool_calls": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "model_calls",
        "tool_calls",
        "context_bytes",
        "response_bytes",
        "output_tokens_per_call"
      ],
      "type": "object"
    },
    "CapabilityDescriptor": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "$ref": "#/$defs/VersionRef"
        },
        "effects": {
          "$ref": "#/$defs/EffectContract"
        },
        "error_codes": {
          "additionalProperties": {
            "$ref": "#/$defs/FailureClass"
          },
          "type": "object"
        },
        "inputs": {
          "additionalProperties": {
            "$ref": "#/$defs/Field"
          },
          "type": "object"
        },
        "outputs": {
          "additionalProperties": {
            "$ref": "#/$defs/Field"
          },
          "type": "object"
        },
        "schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "skill": {
          "anyOf": [
            {
              "$ref": "#/$defs/VersionRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "timeout_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "usage": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "capability",
        "inputs",
        "outputs",
        "timeout_ms",
        "error_codes",
        "effects",
        "usage"
      ],
      "type": "object"
    },
    "EffectContract": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "read_only",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "compensation": {
              "anyOf": [
                {
                  "$ref": "#/$defs/VersionRef"
                },
                {
                  "type": "null"
                }
              ]
            },
            "idempotency": {
              "$ref": "#/$defs/Idempotency"
            },
            "irreversible": {
              "type": "boolean"
            },
            "query": {
              "anyOf": [
                {
                  "$ref": "#/$defs/VersionRef"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "const": "write",
              "type": "string"
            }
          },
          "required": [
            "type",
            "idempotency"
          ],
          "type": "object"
        }
      ]
    },
    "FailureClass": {
      "enum": [
        "invalid_input",
        "permanent",
        "permission_denied",
        "business_rejected",
        "transient",
        "cancelled",
        "unknown_effect"
      ],
      "type": "string"
    },
    "Field": {
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "boolean"
        },
        "value_type": {
          "$ref": "#/$defs/ValueType"
        }
      },
      "required": [
        "value_type",
        "required"
      ],
      "type": "object"
    },
    "Idempotency": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "none",
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "key",
              "type": "string"
            },
            "retention_ms": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "scope": {
              "type": "string"
            }
          },
          "required": [
            "mode",
            "scope",
            "retention_ms"
          ],
          "type": "object"
        }
      ]
    },
    "RetryPolicy": {
      "additionalProperties": false,
      "properties": {
        "initial_backoff_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "max_backoff_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "max_retries": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "max_retries",
        "initial_backoff_ms",
        "max_backoff_ms"
      ],
      "type": "object"
    },
    "ValueType": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "string",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "boolean",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "integer",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "number",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "items": {
              "$ref": "#/$defs/ValueType"
            },
            "type": {
              "const": "array",
              "type": "string"
            }
          },
          "required": [
            "type",
            "items"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "fields": {
              "additionalProperties": {
                "$ref": "#/$defs/ValueType"
              },
              "type": "object"
            },
            "type": {
              "const": "object",
              "type": "string"
            }
          },
          "required": [
            "type",
            "fields"
          ],
          "type": "object"
        }
      ]
    },
    "VersionRef": {
      "additionalProperties": false,
      "description": "Versions are immutable opaque release identifiers, never ranges or `latest`.",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "budget": {
      "$ref": "#/$defs/Budget"
    },
    "goal": {
      "type": "string"
    },
    "policy": {
      "$ref": "#/$defs/VersionRef"
    },
    "retry": {
      "anyOf": [
        {
          "$ref": "#/$defs/RetryPolicy"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "task": {
      "$ref": "#/$defs/CapabilityDescriptor"
    },
    "tools": {
      "items": {
        "$ref": "#/$defs/CapabilityDescriptor"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "policy",
    "task",
    "goal",
    "tools",
    "budget"
  ],
  "title": "PolicySpec",
  "type": "object"
}
