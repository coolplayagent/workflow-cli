          "inputs": {
            "additionalProperties": true,
            "type": "object"
          },
          "instance_id": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "node_id": {
            "type": "string"
          },
          "operation_key": {
            "type": "string"
          },
          "policy": {
            "$ref": "#/$defs/EffectPolicy"
          },
          "release": {
            "anyOf": [
              {
                "$ref": "#/$defs/ReleaseIntent"
              },
              {
                "type": "null"
              }
            ]
