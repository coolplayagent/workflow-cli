            "type": "array"
          },
          "policy": {
            "$ref": "#/$defs/ReleasePolicy"
          },
          "subject": {
            "$ref": "#/$defs/ReleaseSubject"
          }
        },
        "required": [
          "policy",
          "subject",
          "gates",
          "approvals"
        ],
        "type": "object"
