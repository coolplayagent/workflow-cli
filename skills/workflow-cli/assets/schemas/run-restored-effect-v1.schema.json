            "required": [
              "mode"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "mode": {
                "const": "key",
                "type": "string"
              },
              "retention_ms": {
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "scope": {
                "type": "string"
              }
            },
            "required": [
              "mode",
              "scope",
              "retention_ms"
            ],
            "type": "object"
          }
