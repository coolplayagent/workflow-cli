          },
          "max_backoff_ms": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "max_calls": {
            "description": "Includes queries and writes; persists across leases and process restarts.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "total_write_ms": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
