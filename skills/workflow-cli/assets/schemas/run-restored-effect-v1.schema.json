        "type": "object"
      },
      "TargetCheck": {
        "oneOf": [
          {
            "additionalProperties": false,
            "description": "Gateway atomically compares the full subject and applies the operation.",
            "properties": {
              "type": {
                "const": "atomic_compare",
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "Gateway observes before writing; the declared query is required after\nambiguous outcomes. This mode does not claim to close the external race.",
            "properties": {
              "remaining_race": {
                "type": "string"
              },
              "type": {
                "const": "observe_then_reconcile",
                "type": "string"
              }
            },
            "required": [
              "type",
              "remaining_race"
            ],
            "type": "object"
          }
        ]
