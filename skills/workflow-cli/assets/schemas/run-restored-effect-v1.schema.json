            "$ref": "#/$defs/VersionRef"
          }
        },
        "required": [
          "schema_version",
          "operation_key",
          "run_id",
          "run_digest",
          "instance_id",
          "workflow",
          "node_id",
          "command_id",
          "command_digest",
          "capability",
          "inputs",
          "input_digest",
          "policy",
          "created_at_unix_ms"
