            "required": [
              "type"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "boolean",
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "integer",
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "number",
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "items": {
                "$ref": "#/$defs/ValueType"
              },
              "type": {
                "const": "array",
                "type": "string"
              }
            },
            "required": [
              "type",
              "items"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "fields": {
                "additionalProperties": {
                  "$ref": "#/$defs/ValueType"
                },
                "type": "object"
              },
              "type": {
                "const": "object",
                "type": "string"
              }
            },
            "required": [
              "type",
              "fields"
            ],
            "type": "object"
          }
        ]
      },
      "VersionRef": {
        "additionalProperties": false,
        "description": "Versions are immutable opaque release identifiers, never ranges or `latest`.",
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "version"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "intent": {
        "$ref": "#/$defs/EffectIntent"
      },
      "resolution": {
        "$ref": "#/$defs/ManualResolution"
      }
    },
    "required": [
      "intent",
      "resolution"
    ],
    "title": "RestoredEffect",
    "type": "object"
  }
}
