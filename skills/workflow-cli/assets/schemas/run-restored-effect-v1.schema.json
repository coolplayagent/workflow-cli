          "input_digest",
          "artifacts"
        ],
        "type": "object"
      },
      "Requirement": {
        "additionalProperties": false,
        "properties": {
          "capability": {
            "$ref": "#/$defs/VersionRef"
          },
          "contract_digest": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "max_age_ms": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "node_id": {
            "type": "string"
